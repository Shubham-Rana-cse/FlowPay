# Postgres connection string (Neon / Supabase / local)
DATABASE_URL="postgresql://user:password@localhost:5432/payment_orchestrator"

# JWT signing secret — generate with: openssl rand -base64 32
JWT_SECRET="change-me-in-production"

NODE_ENV="development"

# Phase 6 — shared secret for /api/internal/cron/* pollers. Vercel Cron
# sends this automatically as "Authorization: Bearer $CRON_SECRET" when set
# as a project env var; generate one the same way as JWT_SECRET.
CRON_SECRET="change-me-in-production"

# Reserved for future phases — included now so config stays stable
API_KEY_PEPPER=""
WEBHOOK_SECRET_LENGTH="32"
MOCK_BANK_URL="http://localhost:3000/api/internal/mock-bank"
LOG_LEVEL="info"
