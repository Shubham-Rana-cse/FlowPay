// Payment Orchestrator — Prisma Schema
// Full ERD defined now per Phase 0 §4, even though Phase 1 only uses
// Merchant, MerchantSettings, and ApiKey. Remaining models exist so
// later phases add logic, not migrations.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Phase 1 — active now
// ─────────────────────────────────────────────────────────────

model Merchant {
  id           String   @id @default(cuid())
  businessName String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  apiKeys       ApiKey[]
  settings      MerchantSettings?
  orders        Order[]
  webhookEvents WebhookEvent[]
  settlements   Settlement[]

  @@map("merchants")
}

model MerchantSettings {
  merchantId     String  @id
  merchant       Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  autoCapture    Boolean  @default(true)
  defaultCurrency String  @default("INR")
  webhookSecret  String
  // Phase 5 — FR4: merchant-configured webhook endpoint. Nullable: a
  // merchant with no URL configured simply gets no WebhookDelivery attempts
  // (see webhook-delivery-service.ts), not an error.
  webhookUrl     String?
  timezone       String   @default("Asia/Kolkata")

  @@map("merchant_settings")
}

model ApiKey {
  id         String   @id @default(cuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  keyHash    String
  label      String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([merchantId])
  @@map("api_keys")
}

// ─────────────────────────────────────────────────────────────
// Phase 2+ — schema defined now, logic/services built in later phases
// ─────────────────────────────────────────────────────────────

enum OrderStatus {
  CREATED
  PAID
  FAILED
  EXPIRED
}

model Order {
  id         String      @id @default(cuid())
  merchantId String
  merchant   Merchant    @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  amount     Int // minor units — wrap with Money in application code
  currency   String
  reference  String?
  status     OrderStatus @default(CREATED)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  payments Payment[]

  @@index([merchantId])
  @@map("orders")
}

enum PaymentStatus {
  CREATED
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  RETRY
  TIMEOUT
}

model Payment {
  id             String        @id @default(cuid())
  orderId        String
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  merchantId     String // denormalized for query speed
  idempotencyKey String
  amount         Int // minor units
  currency       String
  status         PaymentStatus @default(CREATED)
  provider       String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  attempts PaymentAttempt[]
  events   PaymentEvent[]
  ledgerEntries LedgerEntry[]
  refunds  Refund[]

  // Phase 4 — nullable until a Settlement batch picks this payment up (see Settlement below).
  settlementId String?
  settlement   Settlement? @relation(fields: [settlementId], references: [id])

  // Phase 6 — Open Design Decision #1: cross-request retry, the polling
  // half of "DB retry_at column + polling job". Set whenever a Payment
  // lands in TIMEOUT/RETRY (Phase 3's inline, same-request retries are a
  // separate, unrelated counter — see payment-service.ts) so
  // retry-service.ts's poller knows what's due and how many cross-request
  // attempts have already been made. Both reset to null/0 once a payment
  // leaves TIMEOUT/RETRY for good (AUTHORIZED or FAILED).
  retryCount  Int       @default(0)
  nextRetryAt DateTime?

  @@unique([merchantId, idempotencyKey])
  @@index([orderId])
  @@index([settlementId])
  @@index([status, nextRetryAt])
  @@map("payments")
}

model PaymentAttempt {
  id            String   @id @default(cuid())
  paymentId     String
  payment       Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  provider      String
  status        String
  attemptNumber Int
  providerRef   String?
  errorCode     String?
  createdAt     DateTime @default(now())

  @@index([paymentId])
  @@map("payment_attempts")
}

model PaymentEvent {
  id        String   @id @default(cuid())
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  eventType String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([paymentId])
  @@map("payment_events")
}

model LedgerEntry {
  id           String   @id @default(cuid())
  paymentId    String
  payment      Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  type         String // "debit" | "credit"
  amount       Int
  balanceAfter Int
  createdAt    DateTime @default(now())

  @@index([paymentId])
  @@map("ledger_entries")
}

enum RefundStatus {
  PENDING
  COMPLETED
  FAILED
}

model Refund {
  id        String       @id @default(cuid())
  paymentId String
  payment   Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  amount    Int
  status    RefundStatus @default(PENDING)
  reason    String?
  createdAt DateTime     @default(now())

  @@index([paymentId])
  @@map("refunds")
}

// ─────────────────────────────────────────────────────────────
// Phase 4 addition — not in the original Phase 0 §4 ERD. "Settlement
// simulation" was a named Phase 4 deliverable in the project roadmap but
// wasn't detailed in Phase 0's schema, so this model + Payment.settlementId
// above are added now rather than retrofitted. Simulates a payout batch: a
// merchant-triggered (not yet scheduled — that's Phase 6) grouping of
// eligible captured payments into one payout, mirroring how a real
// processor settles captured funds to a merchant's bank account on a cycle.
// ─────────────────────────────────────────────────────────────

enum SettlementStatus {
  PENDING
  COMPLETED
  FAILED
}

model Settlement {
  id          String           @id @default(cuid())
  merchantId  String
  merchant    Merchant         @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  amount      Int // minor units — net total settled in this batch, one currency per batch
  currency    String
  status      SettlementStatus @default(COMPLETED) // simulation: always completes synchronously, no async payout rail
  periodStart DateTime // oldest included payment's createdAt
  periodEnd   DateTime // time this batch was run
  settledAt   DateTime         @default(now())
  createdAt   DateTime         @default(now())

  payments Payment[]

  @@index([merchantId])
  @@map("settlements")
}

model WebhookEvent {
  id         String   @id @default(cuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  eventType  String
  payload    Json
  createdAt  DateTime @default(now())

  deliveries WebhookDelivery[]

  @@index([merchantId])
  @@map("webhook_events")
}

enum WebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
  RETRYING
}

model WebhookDelivery {
  id            String                @id @default(cuid())
  webhookEventId String
  webhookEvent  WebhookEvent          @relation(fields: [webhookEventId], references: [id], onDelete: Cascade)
  status        WebhookDeliveryStatus @default(PENDING)
  attemptCount  Int                   @default(0)
  nextRetryAt   DateTime?
  deliveredAt   DateTime?
  createdAt     DateTime              @default(now())

  @@index([webhookEventId])
  @@map("webhook_deliveries")
}
